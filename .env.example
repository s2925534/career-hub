# Career Hub environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
# This file uses generic example.com hostnames. Replace them with your own domains.
# See docs/reverse-proxy-domain.md and docs/deployer-integration.md for the full model.

# --- Hostnames -------------------------------------------------------------
# Private career admin/jobs app hostname (generic example: jobs.example.com).
# Personal example used by this project's maintainer: jobs.veloso.dev
CAREER_HUB_PRIVATE_DOMAIN=jobs.example.com
# Public SEO-friendly CV/resume site hostname (generic example: cv.example.com).
# Personal example used by this project's maintainer: cv.veloso.dev
CAREER_HUB_PUBLIC_CV_DOMAIN=cv.example.com

# Full external URLs used to generate absolute links, canonical tags, and sitemaps.
# These should match how the app is actually reached from the outside (through the
# deployer-managed reverse proxy in production, or http://localhost:PORT locally).
CAREER_HUB_PRIVATE_EXTERNAL_URL=https://jobs.example.com
CAREER_HUB_PUBLIC_CV_EXTERNAL_URL=https://cv.example.com

# --- Storage -----------------------------------------------------------------
# Base path for all persistent data (database, uploads, generated files, exports,
# backups, logs, templates, job-source imports, audit log, public assets).
# Portable local default. Do not hardcode /volume1 or any other fixed NAS volume path --
# when deployed via a NAS deployer (e.g. ../synology-site-deployer), the deployer decides
# the final path and passes it in here instead.
CAREER_HUB_BASE_PATH=./data/career-hub
# Example of a deployer-managed path instead of the local default above:
#   CAREER_HUB_BASE_PATH=/path/managed/by/deployer/career-hub

# --- Networking ----------------------------------------------------------------
CAREER_HUB_HTTP_PORT=8088
# 0.0.0.0 for LAN-only/local testing and container use; 127.0.0.1 to bind local-only.
CAREER_HUB_BIND_HOST=0.0.0.0

# --- Application secrets / database -------------------------------------------
# Generate a long random secret, e.g.:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-generate-a-long-random-secret
DATABASE_URL=sqlite:////data/career-hub/database/career-hub.sqlite3

# --- Deployment mode / exposure -------------------------------------------------
# local_only | deployer_managed
DEPLOY_MODE=local_only
# Whether this instance is reachable from the public internet. Actual exposure
# (DNS/Cloudflare/tunnels/reverse proxy) is handled entirely by an external deployer --
# this flag only affects this app's own behavior (e.g. stricter defaults when true).
PUBLIC_EXPOSURE=false
# none | deployer_managed -- this repo never implements Cloudflare/reverse-proxy automation.
REVERSE_PROXY_PROVIDER=deployer_managed
TAILSCALE_ADMIN_ACCESS=true

# --- Authentication --------------------------------------------------------------
ENABLE_LOCAL_AUTH=true
ENABLE_SSO_AUTH=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# --- Public CV site --------------------------------------------------------------
ENABLE_PUBLIC_CV_SITE=true
ENABLE_PUBLIC_CV_SEO=true

# --- AI assistance (future, disabled by default) ----------------------------------
ENABLE_AI_ASSIST=false
AI_PROVIDER=none
AI_BASE_URL=

# --- Job sources / platform integrations (future, disabled by default) -----------
ENABLE_EMAIL_INGESTION=false
ENABLE_PLATFORM_API_INTEGRATIONS=false

# --- Auto-apply (future, disabled by default -- see docs/auto-apply-guardrails.md) -
ENABLE_AUTO_APPLY=false
AUTO_APPLY_MODE=disabled
AUTO_APPLY_REQUIRES_USER_APPROVAL=true
AUTO_APPLY_ALLOWED_SOURCES=official_api,direct_employer_allowed
AUTO_APPLY_BLOCKED_SOURCES=linkedin,seek,indeed_unless_official_api
