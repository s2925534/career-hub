# Example .env for running Career Hub locally, LAN-only, with no deployer involved.
# Copy relevant values into your own .env — do not use this file directly as your real .env.

CAREER_HUB_PRIVATE_DOMAIN=localhost
CAREER_HUB_PUBLIC_CV_DOMAIN=localhost
CAREER_HUB_PRIVATE_EXTERNAL_URL=http://localhost:8088
CAREER_HUB_PUBLIC_CV_EXTERNAL_URL=http://localhost:8088

CAREER_HUB_BASE_PATH=./data/career-hub
CAREER_HUB_HTTP_PORT=8088
CAREER_HUB_BIND_HOST=127.0.0.1

APP_SECRET_KEY=change-me-generate-a-long-random-secret
DATABASE_URL=sqlite:////data/career-hub/database/career-hub.sqlite3

DEPLOY_MODE=local_only
PUBLIC_EXPOSURE=false
REVERSE_PROXY_PROVIDER=none
TAILSCALE_ADMIN_ACCESS=false

ENABLE_LOCAL_AUTH=true
ENABLE_SSO_AUTH=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

ENABLE_PUBLIC_CV_SITE=true
ENABLE_PUBLIC_CV_SEO=false

ENABLE_AI_ASSIST=false
AI_PROVIDER=none
AI_BASE_URL=

ENABLE_EMAIL_INGESTION=false
ENABLE_PLATFORM_API_INTEGRATIONS=false

ENABLE_AUTO_APPLY=false
AUTO_APPLY_MODE=disabled
AUTO_APPLY_REQUIRES_USER_APPROVAL=true
AUTO_APPLY_ALLOWED_SOURCES=official_api,direct_employer_allowed
AUTO_APPLY_BLOCKED_SOURCES=linkedin,seek,indeed_unless_official_api
