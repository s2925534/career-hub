# Example .env for running Career Hub behind an external deployer
# (e.g. ../synology-site-deployer) that manages DNS/Cloudflare/tunnels/certs.
# Copy relevant values into your own .env — do not use this file directly as your real .env.
# Replace the example.com hostnames with your own; the veloso.dev values in comments are one
# maintainer's personal deployment, not a default anyone else should use.

CAREER_HUB_PRIVATE_DOMAIN=jobs.example.com
CAREER_HUB_PUBLIC_CV_DOMAIN=cv.example.com
CAREER_HUB_PRIVATE_EXTERNAL_URL=https://jobs.example.com
CAREER_HUB_PUBLIC_CV_EXTERNAL_URL=https://cv.example.com
# Personal example values used by this repo's maintainer:
#   CAREER_HUB_PRIVATE_DOMAIN=jobs.veloso.dev
#   CAREER_HUB_PUBLIC_CV_DOMAIN=cv.veloso.dev
#   CAREER_HUB_PRIVATE_EXTERNAL_URL=https://jobs.veloso.dev
#   CAREER_HUB_PUBLIC_CV_EXTERNAL_URL=https://cv.veloso.dev

CAREER_HUB_BASE_PATH=/path/managed/by/deployer/career-hub
CAREER_HUB_HTTP_PORT=8088
CAREER_HUB_BIND_HOST=0.0.0.0

APP_SECRET_KEY=change-me-generate-a-long-random-secret
DATABASE_URL=sqlite:////data/career-hub/database/career-hub.sqlite3

DEPLOY_MODE=deployer_managed
PUBLIC_EXPOSURE=true
REVERSE_PROXY_PROVIDER=deployer_managed
TAILSCALE_ADMIN_ACCESS=true

ENABLE_LOCAL_AUTH=true
ENABLE_SSO_AUTH=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

ENABLE_PUBLIC_CV_SITE=true
ENABLE_PUBLIC_CV_SEO=true

ENABLE_AI_ASSIST=false
AI_PROVIDER=none
AI_BASE_URL=

ENABLE_EMAIL_INGESTION=false
ENABLE_PLATFORM_API_INTEGRATIONS=false

ENABLE_AUTO_APPLY=false
AUTO_APPLY_MODE=disabled
AUTO_APPLY_REQUIRES_USER_APPROVAL=true
AUTO_APPLY_ALLOWED_SOURCES=official_api,direct_employer_allowed
AUTO_APPLY_BLOCKED_SOURCES=linkedin,seek,indeed_unless_official_api

# CAREER_HUB_BASE_PATH above is a placeholder: the deployer decides the final NAS path.
# This repo never assumes /volume1 or any other fixed Synology volume path.
